<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_artist"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_10"
    android:layout_marginBottom="@dimen/spacing_10"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/artist_icon"
        android:layout_width="@dimen/icon_size_48"
        android:layout_height="@dimen/icon_size_48"
        android:contentDescription="@null"
        android:src="@drawable/ic_artist" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/spacing_medium"
        android:orientation="vertical">

        <TextView
            android:id="@+id/artist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/mc_track"
            android:textSize="@dimen/text_size_18" />

        <TextView
            android:id="@+id/songs_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:textColor="@color/gray"
            android:textSize="@dimen/text_size_14" />

    </LinearLayout>

</LinearLayout>