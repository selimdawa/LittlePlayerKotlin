<?xml version="1.0" encoding="utf-8"?>
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flexboxContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?colorOnBackground"
    android:padding="6dp"
    app:flexDirection="row"
    app:flexWrap="nowrap"
    app:justifyContent="space_between">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_margin="3dp"
        android:background="@drawable/bg_playlist_rectangle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_flexGrow="1">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_holder"
            android:padding="5dp"
            android:src="@drawable/ic_artist"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="المفضلة"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playlistCount1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 أغنية"
                android:textColor="#99FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_margin="3dp"
        android:background="@drawable/bg_playlist_rectangle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_flexGrow="1">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_holder"
            android:padding="5dp"
            android:src="@drawable/ic_artist"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="مؤخراً"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playlistCount2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42 أغنية"
                android:textColor="#99FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_margin="3dp"
        android:background="@drawable/bg_playlist_rectangle"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_flexGrow="1">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_holder"
            android:padding="5dp"
            android:src="@drawable/ic_artist"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/playlistTitle3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="كل الأغاني"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playlistCount3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150 أغنية"
                android:textColor="#99FFFFFF"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.flexbox.FlexboxLayout>