<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark">

    <ImageView
        android:id="@+id/imageBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@color/dark" />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_30"
            android:layout_marginBottom="@dimen/spacing_10">

            <ImageView
                android:id="@+id/back"
                android:layout_width="@dimen/spacing_40"
                android:layout_height="@dimen/spacing_40"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_20"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_down"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/more"
                android:layout_width="@dimen/spacing_30"
                android:layout_height="@dimen/spacing_30"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_more"
                app:tint="@color/white" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/basicColor"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_24"
                app:cardBackgroundColor="?attr/mc_track"
                app:cardCornerRadius="@dimen/spacing_12"
                app:cardElevation="@dimen/spacing_0"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/spacing_1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/paletteColor"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_8"
                android:layout_toStartOf="@+id/basicColor"
                app:cardBackgroundColor="@color/gray"
                app:cardCornerRadius="@dimen/spacing_12"
                app:cardElevation="@dimen/spacing_0"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/spacing_1" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/whiteColor"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_8"
                android:layout_toStartOf="@+id/paletteColor"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/spacing_12"
                app:cardElevation="@dimen/spacing_0"
                app:strokeColor="@color/white"
                app:strokeWidth="@dimen/spacing_1" />

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/media_route_button"
                android:layout_width="@dimen/spacing_30"
                android:layout_height="@dimen/spacing_30"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_8"
                android:layout_toStartOf="@+id/whiteColor"
                app:mediaRouteButtonTint="@color/white" />

        </RelativeLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_30"
            app:cardBackgroundColor="@color/image_profile"
            app:cardCornerRadius="@dimen/spacing_15"
            app:cardElevation="@dimen/spacing_0"
            app:strokeWidth="@dimen/spacing_0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:transitionName="song_image"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/spacing_24"
                    android:layout_height="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="@dimen/spacing_24"
                    android:layout_height="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="@dimen/spacing_24"
                    android:layout_height="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="@dimen/spacing_24"
                    android:layout_height="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="@dimen/spacing_24"
                    android:layout_height="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_tiny"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_xlarge"
                android:layout_marginTop="@dimen/spacing_10"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_horizontal"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_22"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_40"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_40"
                android:orientation="vertical">

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    android:progressBackgroundTint="?attr/mc_track"
                    android:progressTint="?attr/mc_track"
                    android:secondaryProgressTint="?attr/mc_track"
                    android:thumbTint="?attr/mc_track" />

                <RelativeLayout
                    android:id="@+id/seek_bar_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    android:layout_marginTop="@dimen/spacing_5">

                    <TextView
                        android:id="@+id/durationPlayed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/zero_zero"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_12" />

                    <TextView
                        android:id="@+id/durationTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/zero_zero"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_12" />

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttonPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/repeat"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_repeat_off"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/prev"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="0.5"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/white" />

                <FrameLayout
                    android:id="@+id/play_pause_btn"
                    android:layout_width="@dimen/spacing_80"
                    android:layout_height="@dimen/spacing_80"
                    android:background="@drawable/ic_gradient_border"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/play_pause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play"
                        app:tint="@color/white" />

                </FrameLayout>

                <ImageView
                    android:id="@+id/next"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="0.5"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/favorite"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/white" />

            </LinearLayout>

            <com.masoudss.lib.WaveformSeekBar
                android:id="@+id/waveformSeekBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_60"
                android:layout_marginHorizontal="@dimen/spacing_20"
                android:layout_marginTop="@dimen/spacing_20"
                app:wave_background_color="@color/gray2"
                app:wave_corner_radius="@dimen/spacing_2"
                app:wave_gap="@dimen/spacing_2"
                app:wave_gravity="center"
                app:wave_progress_color="?attr/mc_tick"
                app:wave_width="3dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>