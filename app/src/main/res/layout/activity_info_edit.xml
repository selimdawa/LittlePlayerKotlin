<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark"
    tools:context=".activity.InfoEditActivity">

    <ImageView
        android:id="@+id/imageBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@color/dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/white"
            app:title="@string/tag_editor"
            app:titleCentered="true"
            app:titleTextColor="@color/white" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCover"
                    android:layout_width="@dimen/cover_size_edit"
                    android:layout_height="@dimen/cover_size_edit"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:layout_marginBottom="@dimen/spacing_xlarge"
                    app:cardBackgroundColor="@color/white_10"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/white_10"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/edit_cover"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_cover_song" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnEditCover"
                            android:layout_width="@dimen/icon_size_34"
                            android:layout_height="@dimen/icon_size_34"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="@dimen/spacing_10"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="?attr/mc_track"
                            app:cardCornerRadius="@dimen/radius_17"
                            app:cardElevation="@dimen/spacing_tiny"
                            app:strokeWidth="@dimen/spacing_0">

                            <ImageView
                                android:layout_width="@dimen/icon_size_18"
                                android:layout_height="@dimen/icon_size_18"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/white" />

                        </com.google.android.material.card.MaterialCardView>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white_10"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/white_10"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_24">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:text="@string/title"
                            android:textAllCaps="true"
                            android:textColor="@color/white_66"
                            android:textSize="@dimen/text_size_12"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/song_title"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingVertical="@dimen/spacing_8"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_33"
                            android:textSize="@dimen/text_size_18" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:layout_marginBottom="@dimen/spacing_20"
                            android:background="@color/white_10" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:text="@string/artist"
                            android:textAllCaps="true"
                            android:textColor="@color/white_66"
                            android:textSize="@dimen/text_size_12"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/artist_name"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingVertical="@dimen/spacing_8"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_33"
                            android:textSize="@dimen/text_size_18" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:layout_marginBottom="@dimen/spacing_20"
                            android:background="@color/white_10" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:text="@string/album"
                            android:textAllCaps="true"
                            android:textColor="@color/white_66"
                            android:textSize="@dimen/text_size_12"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etAlbum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="@string/album"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingVertical="@dimen/spacing_8"
                            android:textColor="@color/white"
                            android:textColorHint="@color/white_33"
                            android:textSize="@dimen/text_size_18" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_height"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:background="@color/white_10" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_xlarge"
                    android:layout_marginBottom="@dimen/spacing_30"
                    android:minWidth="@dimen/btn_min_width_large"
                    android:paddingHorizontal="@dimen/spacing_xlarge"
                    android:paddingVertical="@dimen/spacing_12"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16"
                    android:textStyle="bold"
                    app:backgroundTint="@color/white_10"
                    app:cornerRadius="@dimen/radius_large"
                    app:rippleColor="@color/white_40"
                    app:strokeColor="@color/white_10"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
