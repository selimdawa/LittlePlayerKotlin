<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnBackground">

    <include
        android:id="@+id/customToolbar"
        layout="@layout/toolbar_custom" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/fragBottomPlayer"
        android:layout_below="@id/customToolbar"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_player_theme_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_player_theme_desc"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/text_size_14" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBottomPlayerTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:splitTrack="false"
                    android:thumb="@drawable/switch_thumb_custom"
                    app:showText="false"
                    app:switchMinWidth="@dimen/icon_size_48"
                    app:thumbTint="?attr/mc_track"
                    app:track="@drawable/switch_track_custom"
                    app:trackTint="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/itemBasic"
                    layout="@layout/item_now_player_preview" />

                <include
                    android:id="@+id/itemPalette"
                    layout="@layout/item_now_player_preview" />

                <include
                    android:id="@+id/itemWhite"
                    layout="@layout/item_now_player_preview" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_1"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="@dimen/spacing_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_theme_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_theme_desc"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/text_size_14" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchListTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:splitTrack="false"
                    android:thumb="@drawable/switch_thumb_custom"
                    app:showText="false"
                    app:switchMinWidth="@dimen/icon_size_48"
                    app:thumbTint="?attr/mc_track"
                    app:track="@drawable/switch_track_custom"
                    app:trackTint="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/itemListBasic"
                    layout="@layout/item_music_preview" />

                <include
                    android:id="@+id/itemListPalette"
                    layout="@layout/item_music_preview" />

                <include
                    android:id="@+id/itemListWhite"
                    layout="@layout/item_music_preview" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_1"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="@dimen/spacing_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marquee_scrolling"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/marquee_scrolling_desc"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/text_size_14" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMarquee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:splitTrack="false"
                    android:thumb="@drawable/switch_thumb_custom"
                    app:showText="false"
                    app:switchMinWidth="@dimen/icon_size_48"
                    app:thumbTint="?attr/mc_track"
                    app:track="@drawable/switch_track_custom"
                    app:trackTint="@null" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_1"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="@dimen/spacing_medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:text="@string/hidden_folders"
                android:textColor="?attr/mc_track"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHiddenFolders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_medium"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/spacing_0"
                app:strokeWidth="@dimen/spacing_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/hidden_folders"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_size_16"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="@dimen/spacing_24"
                        android:layout_height="@dimen/spacing_24"
                        android:src="@drawable/ic_navigate_next"
                        app:tint="@color/gray" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:text="@string/cache_and_history"
                android:textColor="?attr/colorError"
                android:textSize="@dimen/text_size_14"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_medium"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/spacing_0"
                app:strokeWidth="@dimen/spacing_0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_8">

                    <LinearLayout
                        android:id="@+id/btnClearCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clear_art_cache"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_size_16"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCacheSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zero_mb"
                                android:textColor="@color/gray"
                                android:textSize="@dimen/text_size_14" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/spacing_24"
                            android:layout_height="@dimen/spacing_24"
                            android:src="@drawable/ic_close"
                            app:tint="@color/gray" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_1"
                        android:layout_marginHorizontal="@dimen/spacing_medium"
                        android:background="?attr/colorSurfaceVariant" />

                    <LinearLayout
                        android:id="@+id/btnClearHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clear_recent_history"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_size_16"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clear_recent_history_desc"
                                android:textColor="@color/gray"
                                android:textSize="@dimen/text_size_14" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/spacing_24"
                            android:layout_height="@dimen/spacing_24"
                            android:src="@drawable/ic_close"
                            app:tint="@color/gray" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/fragBottomPlayer"
        layout="@layout/layout_now_player_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
