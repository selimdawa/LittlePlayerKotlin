<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/widget_bg_shape" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <ImageView
            android:id="@+id/widgetArtLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/textContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="20dp"
            android:background="@drawable/widget_art_bg"
            android:contentDescription="@null"
            android:padding="1dp"
            android:scaleType="centerCrop"
            android:src="@color/image_profile" />

        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/widgetControls"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/song_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widgetArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/artist_name"
                android:textColor="@color/white_70"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widgetShuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shuffle_on"
                android:alpha="0.8" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widgetPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_previous" />

            <ImageView
                android:id="@+id/widgetPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="24dp"
                android:padding="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/widgetNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widgetFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite_border"
                android:alpha="0.8" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>