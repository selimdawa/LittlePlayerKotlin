<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorOnBackground"
    android:paddingHorizontal="@dimen/spacing_medium"
    android:paddingVertical="@dimen/spacing_8">

    <LinearLayout
        android:id="@+id/leftControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnShuffle"
            android:layout_width="@dimen/spacing_xlarge"
            android:layout_height="@dimen/spacing_xlarge"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="@dimen/spacing_tiny"
            android:src="@drawable/ic_shuffle"
            app:tint="?attr/mc_track" />

        <TextView
            android:id="@+id/btnShufflePlayback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/shuffle_playback"
            android:textColor="?attr/mc_track"
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnFilterSort"
            android:layout_width="@dimen/spacing_xlarge"
            android:layout_height="@dimen/spacing_xlarge"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="@dimen/spacing_tiny"
            android:src="@drawable/ic_sort"
            android:visibility="gone"
            app:tint="?attr/mc_track" />

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="@dimen/spacing_xlarge"
            android:layout_height="@dimen/spacing_xlarge"
            android:layout_marginStart="@dimen/spacing_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="@dimen/spacing_tiny"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="?attr/mc_track" />

    </LinearLayout>

</RelativeLayout>