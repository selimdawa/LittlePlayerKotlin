<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:src="@drawable/widget_bg_shape" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <ImageView
            android:id="@+id/widgetLogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/widgetAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/widgetLogo"
            android:layout_alignBottom="@id/widgetLogo"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/widgetLogo"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:alpha="0.6"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/widgetControls"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:text="@string/song_title"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/widgetArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/artist_name"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp"
                android:alpha="0.8" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widgetShuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shuffle_on"
                android:alpha="0.7" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widgetPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_previous" />

            <ImageView
                android:id="@+id/widgetPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="20dp"
                android:padding="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/widgetNext"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_next" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widgetFavorite"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite_border"
                android:alpha="0.7" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>