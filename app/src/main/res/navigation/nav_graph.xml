<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/songsFragment">

    <fragment
        android:id="@+id/songsFragment"
        android:name="com.flatcode.littleplayer.fragment.SongsFragment"
        android:label="Songs"
        tools:layout="@layout/fragment_songs" />

    <fragment
        android:id="@+id/albumsFragment"
        android:name="com.flatcode.littleplayer.fragment.AlbumsFragment"
        android:label="Albums"
        tools:layout="@layout/fragment_albums">
        <action
            android:id="@+id/action_albumsFragment_to_albumDetailsActivity"
            app:destination="@id/albumDetailsActivity" />
    </fragment>

    <fragment
        android:id="@+id/artistsFragment"
        android:name="com.flatcode.littleplayer.fragment.ArtistsFragment"
        android:label="Artists"
        tools:layout="@layout/fragment_artists">
        <action
            android:id="@+id/action_artistsFragment_to_artistDetailsActivity"
            app:destination="@id/artistDetailsActivity" />
    </fragment>

    <fragment
        android:id="@+id/foldersFragment"
        android:name="com.flatcode.littleplayer.fragment.FoldersFragment"
        android:label="Folders"
        tools:layout="@layout/fragment_folders">
        <action
            android:id="@+id/action_foldersFragment_to_folderDetailsActivity"
            app:destination="@id/folderDetailsActivity" />
    </fragment>

    <activity
        android:id="@+id/albumDetailsActivity"
        android:name="com.flatcode.littleplayer.activity.AlbumDetailsActivity"
        android:label="AlbumDetailsActivity">
        <argument
            android:name="albumName"
            app:argType="string" />
    </activity>

    <activity
        android:id="@+id/artistDetailsActivity"
        android:name="com.flatcode.littleplayer.activity.ArtistDetailsActivity"
        android:label="ArtistDetailsActivity">
        <argument
            android:name="artistName"
            app:argType="string" />
    </activity>

    <activity
        android:id="@+id/folderDetailsActivity"
        android:name="com.flatcode.littleplayer.activity.FolderDetailsActivity"
        android:label="FolderDetailsActivity">
        <argument
            android:name="folderName"
            app:argType="string" />
        <argument
            android:name="folderPath"
            app:argType="string" />
    </activity>

</navigation>