<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow Layer (Halo) -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="25dp"
                android:startColor="#60FFFFFF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Ring Layer -->
    <item
        android:bottom="@dimen/spacing_5"
        android:left="@dimen/spacing_5"
        android:right="@dimen/spacing_5"
        android:top="@dimen/spacing_5">
        <shape
            android:innerRadiusRatio="2.5"
            android:shape="ring"
            android:thickness="@dimen/thickness_small"
            android:useLevel="false">
            <gradient
                android:angle="45"
                android:endColor="?attr/mc_tick"
                android:startColor="?attr/mc_track"
                android:type="linear" />
        </shape>
    </item>
</layer-list>