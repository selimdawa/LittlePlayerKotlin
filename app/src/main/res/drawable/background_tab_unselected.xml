<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="?mc_tick"
                android:startColor="?mc_track"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <!-- Use @color/dark to match TabLayout background, effectively making it look like a border only -->
            <solid android:color="?colorOnBackground" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>