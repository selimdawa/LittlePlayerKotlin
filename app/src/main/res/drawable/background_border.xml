<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="?attr/mc_tick"
                android:startColor="?attr/mc_track"
                android:type="linear" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
    <item
        android:bottom="@dimen/inset_small"
        android:left="@dimen/inset_small"
        android:right="@dimen/inset_small"
        android:top="@dimen/inset_small">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="@dimen/radius_medium" />
        </shape>
    </item>
</layer-list>