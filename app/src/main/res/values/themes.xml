<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ShapeAppearance.App.CircleImage" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.Rounded14" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Custom Activity Animations -->
    <style name="ActivityAnimation.SlideUpDown" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_up</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_down</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- Theme for PlayerActivity with Slide Animations -->
    <style name="Theme.PlayerActivity" parent="Theme.MC.S1">
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnimation.SlideUpDown</item>
        <!-- Ensure the activity is fullscreen if needed, as seen in PlayerActivity.kt -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges
        </item>
    </style>

    <style name="Theme.Splash" parent="Theme.MC.S1">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>